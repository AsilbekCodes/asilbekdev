{
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://api.asilbekdev.uz/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/",
      "destination": "https://api.asilbekdev.uz/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/:path+",
      "destination": "https://api.asilbekdev.uz/admin/:path+",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/media/:path*", "destination": "https://api.asilbekdev.uz/media/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}